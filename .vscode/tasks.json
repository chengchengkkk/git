{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "C: build current file",
      "type": "process",
      "command": "D:/msys64/ucrt64/bin/gcc.exe",
      "args": ["-std=c17", "-Wall", "-Wextra", "-g", "${file}", "-o", "${fileDirname}/${fileBasenameNoExtension}.exe"],
      "options": {
        "cwd": "${fileDirname}",
        "env": {
          "PATH": "D:\\msys64\\ucrt64\\bin;${env:PATH}",
          "TMP": "D:\\msys64\\tmp",
          "TEMP": "D:\\msys64\\tmp"
        }
      },
      "problemMatcher": ["$gcc"],
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
